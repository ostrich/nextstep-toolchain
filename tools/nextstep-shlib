ROOT = Path(__file__).resolve().parents[1]
ARCHES = ['m68k', 'i386', 'hppa', 'sparc']
BODY_PREFIX = '_ns33_shlib_body'

def normalize_archive_headers(raw):
    """Normalize copied legacy members too; libtool -D preserves their headers."""
    data=bytearray(raw)
    if not data.startswith(b'!<arch>\n'):raise ValueError('Expected thin import archive')
    cursor=8
    while cursor<len(data):
        if cursor+60>len(data) or data[cursor+58:cursor+60]!=b'`\n':
            raise ValueError('Malformed import archive during normalization')
        size=int(data[cursor+48:cursor+58])
        if size<0 or cursor+60+size>len(data):raise ValueError('Invalid normalized member extent')
        for offset,width,value in [(16,12,b'0'),(28,6,b'0'),(34,6,b'0'),(40,8,b'100644')]:
            data[cursor+offset:cursor+offset+width]=value.ljust(width)
        cursor+=60+size+size%2
    return bytes(data)

def localize_bodies(raw, names):
    """Localize implementation symbols without touching code or relocations.

    Only the constructor's classic thin Mach-O products are accepted. Archive
    symbol indexes must be regenerated by ranlib after this metadata edit.
    """
    data=bytearray(raw)
    if data.startswith(b'!<arch>\n'):
        cursor=8
        while cursor<len(data):
            if cursor+60>len(data) or data[cursor+58:cursor+60]!=b'`\n':
                raise ValueError('Invalid import archive during body localization')
            size=int(data[cursor+48:cursor+58]);start=cursor+60;end=start+size
            if size<0 or end>len(data):raise ValueError('Invalid import member extent')
            name=bytes(data[cursor:cursor+16]).rstrip()
            if name.startswith(b'#1/'):
                length=int(name[3:])
                if length<0 or length>size:raise ValueError('Invalid import member name')
                start+=length
            if data[start:start+4] in (b'\xce\xfa\xed\xfe',b'\xfe\xed\xfa\xce'):
                data[start:end]=localize_bodies(bytes(data[start:end]),names)
            cursor=end+size%2
        return bytes(data)
    if len(data)<28 or data[:4] not in (b'\xce\xfa\xed\xfe',b'\xfe\xed\xfa\xce'):
        raise ValueError('Expected thin Mach-O for body localization')
    endian='<' if data[:4]==b'\xce\xfa\xed\xfe' else '>'
    header=struct.unpack_from(endian+'7I',data)
    if 28+header[5]>len(data):raise ValueError('Truncated body-localization commands')
    cursor=28;symbol_table=None
    for _ in range(header[4]):
        if cursor+8>28+header[5]:raise ValueError('Invalid body-localization command')
        command,size=struct.unpack_from(endian+'II',data,cursor)
        if size<8 or cursor+size>28+header[5]:raise ValueError('Invalid command extent')
        if command==0xb:raise ValueError('Dynamic symbol tables cannot be localized this way')
        if command==2:
            if size!=24 or symbol_table is not None:raise ValueError('Invalid symbol command')
            symbol_table=struct.unpack_from(endian+'4I',data,cursor+8)
        cursor+=size
    if symbol_table is None:raise ValueError('Missing body-localization symbol table')
    offset,count,string_offset,string_size=symbol_table
    if offset+12*count>len(data) or string_offset+string_size>len(data):
        raise ValueError('Truncated body-localization symbols')
    strings=bytes(data[string_offset:string_offset+string_size])
    for index in range(count):
        entry=offset+12*index
        string,kind,section,desc,value=struct.unpack_from(endian+'IBBhI',data,entry)
        if kind&0xe0:continue
        if string>=len(strings):raise ValueError('Invalid body symbol string')
        name=strings[string:].split(b'\0')[0].decode()
        if name in names:
            if kind&0x0e not in (2,0x0e):raise ValueError('Undefined implementation body: '+name)
            data[entry+4]=kind&~1
    return bytes(data)
def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()
def merge_identity(identities, name, identity):
    """Combine compatible minimum-version requirements for one fixed mapping."""
    previous=identities.get(name)
    if previous is not None:
        if (previous['header_address']!=identity['header_address'] or
                previous['segments']!=identity['segments']):
            raise ValueError('Conflicting dependency identity: '+name)
        identity=dict(identity,minor_version=max(previous['minor_version'],identity['minor_version']))
    identities[name]=identity

def import_identities(path):
    """Read load identities and mapped ranges from a thin BSD import archive."""
    raw=path.read_bytes()
    if not raw.startswith(b'!<arch>\n'):raise ValueError('Expected thin import archive')
    offset=8; identities={}
    while offset<len(raw):
        if offset+60>len(raw) or raw[offset+58:offset+60]!=b'`\n':
            raise ValueError('Malformed import archive header')
        header=raw[offset:offset+60];size=int(header[48:58]);start=offset+60
        if size<0:raise ValueError('Negative import archive member size')
        end=start+size
        if end>len(raw):raise ValueError('Truncated import archive member')
        name=header[:16].rstrip()
        if name.startswith(b'#1/'):
            length=int(name[3:])
            if length>size:raise ValueError('Invalid archive member name length')
            start+=length
        body=raw[start:end];offset=end+(size%2)
        if body[:4] not in (b'\xce\xfa\xed\xfe',b'\xfe\xed\xfa\xce'):continue
        endian='<' if body[:4]==b'\xce\xfa\xed\xfe' else '>'
        if len(body)<28:raise ValueError('Truncated import Mach-O header')
        ncmds,cmdbytes=struct.unpack_from(endian+'II',body,16)
        if 28+cmdbytes>len(body):raise ValueError('Truncated import load commands')
        cursor=28;loads=[];segments=[]
        for _ in range(ncmds):
            if cursor+8>28+cmdbytes:raise ValueError('Truncated import load command')
            command,length=struct.unpack_from(endian+'II',body,cursor)
            if length<8 or cursor+length>28+cmdbytes:raise ValueError('Invalid import load command size')
            if command==6:
                if length<20:raise ValueError('Truncated fixed-VM load command')
                nameoff,minor,address=struct.unpack_from(endian+'III',body,cursor+8)
                if not 20<=nameoff<length:raise ValueError('Invalid fixed-VM name offset')
                value=body[cursor+nameoff:cursor+length]
                if b'\0' not in value:raise ValueError('Unterminated fixed-VM name')
                loads.append((value.split(b'\0')[0].decode(),minor,address))
            elif command==1:
                if length<56:raise ValueError('Truncated segment command')
                address,size=struct.unpack_from(endian+'II',body,cursor+24)
                if address+size>0x100000000:raise ValueError('Invalid dependency segment range')
                if size:segments.append((address,size))
            cursor+=length
        if cursor!=28+cmdbytes:raise ValueError('Inconsistent import load command count')
        if loads:
            if len(loads)!=1:raise ValueError('Expected one runtime identity per import load member')
            name,minor,address=loads[0]
            identity={'minor_version':minor,'header_address':address,'segments':sorted(segments)}
            merge_identity(identities,name,identity)
    if not identities:raise ValueError('Dependency has no fixed-VM load identities')
    return identities

def raise_import_minors(path, identities):
    """Keep the maximum minimum version in every duplicate closure member.

    libtool can retain the first member defining a load marker. Updating only
    the merged metadata would let dependency ordering lower the final floor.
    Validate first and modify only the fixed-width minor-version words.
    """
    original=import_identities(path)
    for name,identity in original.items():
        expected=identities[name]
        if (identity['header_address']!=expected['header_address'] or
                identity['segments']!=expected['segments'] or
                identity['minor_version']>expected['minor_version']):
            raise ValueError('Inconsistent merged dependency identity: '+name)
    raw=bytearray(path.read_bytes());offset=8
    while offset<len(raw):
        header=raw[offset:offset+60];size=int(header[48:58]);start=offset+60
        end=start+size;name=header[:16].rstrip()
        if name.startswith(b'#1/'):start+=int(name[3:])
        offset=end+(size%2)
        if raw[start:start+4] not in (b'\xce\xfa\xed\xfe',b'\xfe\xed\xfa\xce'):continue
        endian='<' if raw[start:start+4]==b'\xce\xfa\xed\xfe' else '>'
        count=struct.unpack_from(endian+'I',raw,start+16)[0];cursor=start+28
        for _ in range(count):
            command,length=struct.unpack_from(endian+'II',raw,cursor)
            if command==6:
                nameoff=struct.unpack_from(endian+'I',raw,cursor+8)[0]
                name=bytes(raw[cursor+nameoff:cursor+length]).split(b'\0')[0].decode()
                struct.pack_into(endian+'I',raw,cursor+12,identities[name]['minor_version'])
            cursor+=length
    path.write_bytes(raw)

def _archive_members(raw):
    if not raw.startswith(b'!<arch>\n'):
        raise ValueError('Expected thin import archive')
    cursor=8
    while cursor<len(raw):
        if cursor+60>len(raw) or raw[cursor+58:cursor+60]!=b'`\n':
            raise ValueError('Malformed import archive member')
        header=raw[cursor:cursor+60]
        size=int(header[48:58]);start=cursor+60;end=start+size
        if size<0 or end>len(raw):raise ValueError('Invalid import member extent')
        name=header[:16].rstrip();prefix=b''
        if name.startswith(b'#1/'):
            length=int(name[3:])
            if length<0 or length>size:raise ValueError('Invalid import member name')
            prefix=raw[start:start+length];start+=length
        yield header,prefix,raw[start:end]
        cursor=end+size%2

def _load_member(body, extra=None, minor=None):
    """Inspect or extend the symbol-only load member without losing its hints."""
    if body[:4] not in (b'\xce\xfa\xed\xfe',b'\xfe\xed\xfa\xce'):return None
    endian='<' if body[:4]==b'\xce\xfa\xed\xfe' else '>'
    if len(body)<28:raise ValueError('Truncated import object')
    count,cmdbytes=struct.unpack_from(endian+'II',body,16)
    if 28+cmdbytes>len(body):raise ValueError('Truncated import commands')
    cursor=28;load=None;table=None;sections=False;commands=set()
    for _ in range(count):
        command,size=struct.unpack_from(endian+'II',body,cursor)
        commands.add(command)
        if size<8 or cursor+size>28+cmdbytes:raise ValueError('Invalid import command')
        if command==6:
            if load is not None:raise ValueError('Multiple import load identities')
            nameoff=struct.unpack_from(endian+'I',body,cursor+8)[0]
            load=(body[cursor+nameoff:cursor+size].split(b'\0')[0].decode(),cursor)
        elif command==2:
            table=(cursor,*struct.unpack_from(endian+'4I',body,cursor+8))
        elif command==1:
            sections |= struct.unpack_from(endian+'I',body,cursor+48)[0]!=0
        cursor+=size
    if not load:return None
    if sections or table is None:raise ValueError('Load metadata must be symbol-only')
    pos,symoff,nsyms,stroff,strsize=table
    if symoff+12*nsyms>len(body) or stroff+strsize>len(body):
        raise ValueError('Invalid import metadata symbols')
    strings=body[stroff:stroff+strsize];undefined=set();names=set()
    for index in range(nsyms):
        string,kind,section,desc,value=struct.unpack_from(endian+'IBBhI',body,symoff+12*index)
        if string>=len(strings):raise ValueError('Invalid import metadata string')
        name=strings[string:].split(b'\0')[0].decode();names.add(name)
        if kind==1 and value==0:undefined.add(name)
    if extra is None:return load[0],undefined
    data=bytearray(body)
    if minor is not None:struct.pack_into(endian+'I',data,load[1]+12,minor)
    added=sorted(set(extra)-names)
    if not added:return bytes(data)
    tail=body[stroff+strsize:]
    if (stroff!=symoff+12*nsyms or commands-{1,2,6} or len(tail)>16 or
            any(value not in (0,10) for value in tail)):
        raise ValueError('Unsupported layout for extended import metadata')
    entries=bytearray();newstrings=bytearray(strings)
    for name in added:
        entries+=struct.pack(endian+'IBBhI',len(newstrings),1,0,0,0)
        newstrings+=name.encode()+b'\0'
    data=bytearray(data[:stroff])+entries+newstrings+tail
    struct.pack_into(endian+'4I',data,pos+8,symoff,nsyms+len(added),stroff+len(entries),len(newstrings))
    return bytes(data)

def normalize_link_imports(arguments, arch, tools, directory, run):
    """Raise every visible import to a coherent version and dependency closure.

    Keep archives and member extraction at their original link positions. The
    classic linker coalesces matching absolute definitions, not ordinary code.
    """
    original_arguments=list(arguments)
    arguments=list(map(str,original_arguments));directories=[]
    for i,arg in enumerate(arguments):
        if arg=='-L' and i+1<len(arguments):directories.append(Path(arguments[i+1]))
        elif arg.startswith('-L') and len(arg)>2:directories.append(Path(arg[2:]))
    candidates={};positions={}
    for i,arg in enumerate(arguments):
        path=None
        if arg.startswith('-l') and len(arg)>2:
            path=next((p for d in directories if (p:=d/('lib'+arg[2:]+'.a')).is_file()),None)
        elif not arg.startswith('-') and Path(arg).is_file() and Path(arg).suffix=='.a':path=Path(arg)
        if path is None:continue
        path=path.resolve();positions[i]=path
        if path in candidates:continue
        with path.open('rb') as stream:magic=stream.read(4)
        thin=path
        if magic in (b'\xca\xfe\xba\xbe',b'\xbe\xba\xfe\xca'):
            thin=directory/('scan-'+str(len(candidates))+'.a')
            run([tools/'lipo',path,'-thin',arch,'-output',thin])
        raw=thin.read_bytes()
        if not raw.startswith(b'!<arch>\n') or b'.shared_library_information_' not in raw:
            candidates[path]=None;continue
        try:identities=import_identities(thin)
        except ValueError as error:
            if str(error)=='Dependency has no fixed-VM load identities':
                candidates[path]=None;continue
            raise
        candidates[path]=(thin,raw,identities)
    merged={};requirements={};basenames={};occupied=[]
    for value in candidates.values():
        if value is None:continue
        thin,raw,identities=value
        for name,identity in identities.items():merge_identity(merged,name,identity)
        for header,prefix,body in _archive_members(raw):
            info=_load_member(body)
            if info:requirements.setdefault(info[0],set()).update(info[1])
    for name,identity in merged.items():
        base=Path(name).name
        if base in basenames and basenames[base]!=name:
            raise ValueError('Conflicting fixed-VM identity basename: '+base)
        basenames[base]=name
        for address,size in identity['segments']:
            for other,start,length in occupied:
                if address<start+length and start<address+size:
                    raise ValueError('Overlapping dependency mappings: '+name+' and '+other)
            occupied.append((name,address,size))
    replacements={}
    for path,value in candidates.items():
        if value is None:continue
        thin,raw,identities=value;output=bytearray(b'!<arch>\n')
        for header,prefix,body in _archive_members(raw):
            info=_load_member(body)
            if info:
                name=info[0]
                body=_load_member(body,requirements[name],merged[name]['minor_version'])
            size=len(prefix)+len(body);header=bytearray(header)
            header[48:58]=str(size).encode().ljust(10)
            output+=header+prefix+body
            if size%2:output+=b'\n'
        if output!=raw:
            destination=directory/('normalized-'+str(len(replacements))+'.a')
            destination.write_bytes(output)
            # Member growth invalidates archive indexes. Rebuild in the private
            # copy; never mutate SDKs or caller-owned import archives.
            run([tools/'ranlib','-D',destination])
            replacements[path]=destination
    return [replacements.get(positions.get(i),original_arguments[i]) for i in range(len(arguments))]

def reserve_import_member(raw, addresses, reserve, markers):
    """Preserve FVMLIB segment hints and add closure-trigger undefined symbols.

    ld -r drops the special segment hints, so this symbol-only object must be
    rebuilt directly rather than passed through a relocatable link.
    """
    endian='<' if raw[:4]==b'\xce\xfa\xed\xfe' else '>'
    header=list(struct.unpack_from(endian+'7I',raw))
    if header[0]!=0xfeedface or header[3]!=1:raise ValueError('Expected import MH_OBJECT')
    offset=28;load=None;symbols=None;strings=None
    for _ in range(header[4]):
        cmd,size=struct.unpack_from(endian+'II',raw,offset)
        if cmd==6:
            if load is not None:raise ValueError('Multiple import load identities')
            load=raw[offset:offset+size]
        elif cmd==2:
            symoff,count,stroff,strsize=struct.unpack_from(endian+'4I',raw,offset+8)
            symbols=raw[symoff:symoff+12*count];strings=raw[stroff:stroff+strsize]
        elif cmd==1:
            if size!=56:raise ValueError('Unexpected sections in import load member')
        else:raise ValueError('Unsupported import member command')
        offset+=size
    if load is None or symbols is None or strings is None:
        raise ValueError('Incomplete import load member')
    for marker in sorted(markers):
        symbols+=struct.pack(endian+'IBBhI',len(strings),1,0,0,0)
        strings+=marker.encode()+b'\0'
    segments=[]
    for name,key,protection in [('__TEXT','text',5),('__DATA','data',3)]:
        segments.append(struct.pack(endian+'II16s8I',1,56,name.encode(),
            addresses[key],reserve,0,0,7,protection,0,2))
    commands=b''.join(segments)+load
    symoff=28+len(commands)+24
    commands+=struct.pack(endian+'6I',2,24,symoff,len(symbols)//12,symoff+len(symbols),len(strings))
    header[4]=4;header[5]=len(commands)
    return struct.pack(endian+'7I',*header)+commands+symbols+strings

def object_layout(raw):
    """Read section-relative data atom extents from a 32-bit Mach-O object."""
    if raw[:4] not in (b'\xce\xfa\xed\xfe',b'\xfe\xed\xfa\xce'):
        raise ValueError('Expected 32-bit Mach-O object')
    endian='<' if raw[:4]==b'\xce\xfa\xed\xfe' else '>'
    header=struct.unpack_from(endian+'7I',raw)
    if header[3]!=1:raise ValueError('Expected MH_OBJECT for data layout')
    cursor=28;sections=[];symtab=None
    for _ in range(header[4]):
        command,size=struct.unpack_from(endian+'II',raw,cursor)
        if size<8 or cursor+size>28+header[5]:raise ValueError('Invalid object load command')
        if command==1:
            count=struct.unpack_from(endian+'I',raw,cursor+48)[0]
            if 56+68*count>size:raise ValueError('Invalid object section count')
            for index in range(count):
                pos=cursor+56+index*68
                sect,seg=(raw[pos+n:pos+n+16].split(b'\0')[0].decode() for n in [0,16])
                addr,length,offset,align=struct.unpack_from(endian+'4I',raw,pos+32)
                sections.append({'name':sect,'segment':seg,'address':addr,'size':length,
                                 'offset':offset,'alignment':1<<align,'header_offset':pos})
        elif command==2:symtab=struct.unpack_from(endian+'4I',raw,cursor+8)
        cursor+=size
    if symtab is None:raise ValueError('Object has no symbol table')
    symoff,count,stroff,strsize=symtab
    if symoff+12*count>len(raw) or stroff+strsize>len(raw):raise ValueError('Truncated object symbols')
    strings=raw[stroff:stroff+strsize];symbols={};boundaries={}
    for index in range(count):
        string,kind,section,desc,value=struct.unpack_from(endian+'IBBhI',raw,symoff+12*index)
        if kind&0xe0 or kind&0x0e!=0x0e:continue
        if not 1<=section<=len(sections):raise ValueError('Invalid symbol section')
        if string>=len(strings):raise ValueError('Invalid object symbol name')
        name=strings[string:].split(b'\0')[0].decode()
        symbols[name]={'section':section,'value':value}
        boundaries.setdefault(section,set()).add(value)
    for name,symbol in symbols.items():
        section=sections[symbol['section']-1];value=symbol['value']
        end=min([n for n in boundaries[symbol['section']] if n>value]+[section['address']+section['size']])
        symbol['extent']=end-value
    return sections,symbols

def prepare_data_exports(path, entries, addresses, reserve):
    """Order public atoms into fixed-size ABI slots, preserving const protection."""
    raw=bytearray(path.read_bytes());sections,symbols=object_layout(raw)
    const=any(entry['kind']=='const' for entry in entries)
    if const:
        for section in sections:
            if section['name']=='__const':
                pos=section['header_offset'];raw[pos+16:pos+32]=b'__ABI'+b'\0'*11
        path.write_bytes(raw)
    offsets={'const':0,'data':0};orders={'const':[],'data':[]};assembly=[];layout={};private=[]
    for index,entry in enumerate(entries):
        name=entry.get('name');kind=entry['kind'];slot=entry.get('slot_size',256)
        base=addresses['text']+reserve//2 if kind=='const' else addresses['data']
        offset=offsets[kind];extent=0
        # Each slot's explicit linker alignment must match its recorded ABI
        # address. Mixed slot sizes can require a gap before the next object.
        aligned=(offset+slot-1)&~(slot-1)
        if aligned!=offset:
            label='_ns33_shlib_abi_alignment_'+str(index)
            segment,section=('__ABI','__const') if kind=='const' else ('__DATA','__data')
            assembly+=['.section '+segment+','+section,'.globl '+label,label+':',
                       '.space '+str(aligned-offset)]
            orders[kind]+=['.symbol_align 0',label];private.append(label)
        offset=aligned;offsets[kind]=aligned
        if name:
            if name not in symbols:raise ValueError('Missing data export: '+name)
            symbol=symbols[name];section=sections[symbol['section']-1]
            allowed=(section['name']=='__const' if kind=='const' else
                     section['segment']=='__DATA' and section['name']=='__data')
            if not allowed:raise ValueError('Unsupported section for data export: '+name)
            extent=symbol['extent']
            if extent<=0 or extent>slot or slot%section['alignment']:
                raise ValueError('Data atom exceeds or misaligns its ABI slot: '+name)
            orders[kind]+=['.symbol_align '+str(slot.bit_length()-1),name]
            layout[name]={'address':base+offset,'slot_size':slot,'atom_extent':extent,'kind':kind}
        padding=slot-extent
        if padding:
            label='_ns33_shlib_abi_padding_'+str(index)
            segment,section=('__ABI','__const') if kind=='const' else ('__DATA','__data')
            assembly+=['.section '+segment+','+section,'.globl '+label,label+':','.space '+str(padding)]
            orders[kind]+=['.symbol_align 0',label];private.append(label)
        offsets[kind]+=slot
    if offsets['const']>reserve//2 or offsets['data']>reserve:
        raise ValueError('Data ABI slots exceed segment reservation')
    return layout,orders,assembly,private

def main():
    global ROOT
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--toolchain', type=Path, default=ROOT,
                   help='Installed runtime/support bundle for a development constructor')
    p.add_argument('--host-tools', type=Path,
                   help='Explicit development cctools candidate; mkshlib comes from the bundle')
    p.add_argument('--retain-debug', action='store_true', help='Retain DWARF objects beside the runtime')
    p.add_argument('--sdk', type=Path, default=Path(os.environ.get('NEXTSTEP_SDK', ROOT/'sdk/nextstep3.3')))
    p.add_argument('--spec', type=Path, required=True, help='Versioned address and function export specification')
    p.add_argument('--output', type=Path, required=True, help='Runtime .shlib file')
    p.add_argument('--import-library', type=Path, required=True, help='Link-time .a file')
    p.add_argument('--arch', action='append', choices=ARCHES)
    p.add_argument('--dependency', action='append', type=Path, default=[],
                   help='Shared import archive; propagate its runtime closure to consumers')
    p.add_argument('--build-record', type=Path, required=True)
    p.add_argument('objects', nargs='+', type=Path, help='Fat or matching thin objects; archives are searched in order')
    a=p.parse_args()
    arches=list(dict.fromkeys(a.arch or ARCHES))
    sdk=a.sdk.resolve(); spec=json.loads(a.spec.read_text())
