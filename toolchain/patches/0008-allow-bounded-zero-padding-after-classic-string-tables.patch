@@ -715,6 +715,9 @@
 {
     uint32_t end, sigend, strend, rounded_strend;
     uint32_t indirectend, rounded_indirectend;
+#ifdef NEXTSTEP_CCTOOLS
+    uint32_t nextstep_padding = 0;
