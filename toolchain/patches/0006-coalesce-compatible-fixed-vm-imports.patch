+/* Import archives can repeat an older compatible view of the same fixed-VM
+ * module. Only symbol-only members with a matching module marker qualify;
+ * ordinary duplicate absolute symbols retain the usual diagnostic. */
+static enum bool
+same_fvmlib_symbol_module(struct object_file *a, struct object_file *b)
+{
+    struct nlist *sa, *sb;
+    char *sta, *stb;
+    unsigned long i, j;
+    struct object_file *objects[2];
+    unsigned long n, definitions[2] = {0, 0}, values[2] = {0, 0};
+    char *names[2] = {NULL, NULL};
+    unsigned char marker_type = N_ABS | N_EXT;
+
+    if(a == NULL || b == NULL || a->symtab == NULL || b->symtab == NULL)
+        return(FALSE);
+    objects[0] = a;
+    objects[1] = b;
+    for(n = 0; n < 2; n++){
+        sa = (struct nlist *)(objects[n]->obj_addr + objects[n]->symtab->symoff);
+        for(i = 0; i < objects[n]->symtab->nsyms; i++){
+            if((sa[i].n_type & N_STAB) || !(sa[i].n_type & N_EXT))
+                continue;
+            if((sa[i].n_type & N_TYPE) == N_UNDF && sa[i].n_value == 0)
+                continue;
+            if((sa[i].n_type & N_TYPE) != N_ABS)
+                return(FALSE);
+            definitions[n]++;
+            names[n] = objects[n]->obj_addr + objects[n]->symtab->stroff + sa[i].n_un.n_strx;
+            values[n] = sa[i].n_value;
+        }
+    }
+    if(a->fvmlib_stuff && b->fvmlib_stuff){
+        char *load_names[2] = {NULL, NULL};
+        struct mach_header *mh;
+        struct load_command *lc;
+        struct fvmlib_command *fl;
+        for(n = 0; n < 2; n++){
+            mh = (struct mach_header *)objects[n]->obj_addr;
+            lc = (struct load_command *)(objects[n]->obj_addr + sizeof(*mh));
+            for(i = 0; i < mh->ncmds; i++){
+                if(lc->cmd == LC_LOADFVMLIB){
+                    if(load_names[n] != NULL) return(FALSE);
+                    fl = (struct fvmlib_command *)lc;
+                    load_names[n] = (char *)fl + fl->fvmlib.name.offset;
+                }
+                lc = (struct load_command *)((char *)lc + lc->cmdsize);
+            }
+        }
+        return(load_names[0] != NULL && load_names[1] != NULL &&
+               strcmp(load_names[0], load_names[1]) == 0);
+    }
+    /* __.FVMLIB_REF has one bare library-name definition and undefined
+     * file-definition markers. Coalesce only matching reference modules. */
+    if(definitions[0] == 1 && definitions[1] == 1 && values[0] == 0 && values[1] == 0 &&
+       names[0][0] != '_' && names[0][0] != '.' && strcmp(names[0], names[1]) == 0)
+        marker_type = N_UNDF | N_EXT;
+    sa = (struct nlist *)(a->obj_addr + a->symtab->symoff);
+    sb = (struct nlist *)(b->obj_addr + b->symtab->symoff);
+    sta = a->obj_addr + a->symtab->stroff;
+    stb = b->obj_addr + b->symtab->stroff;
+    for(i = 0; i < a->symtab->nsyms; i++){
+        if(sa[i].n_type != marker_type || sa[i].n_value != 0 ||
+           strncmp(sta + sa[i].n_un.n_strx, ".file_definition_", 17) != 0)
+            continue;
+        for(j = 0; j < b->symtab->nsyms; j++){
+            if(sb[j].n_type == marker_type && sb[j].n_value == 0 &&
+               strcmp(sta + sa[i].n_un.n_strx, stb + sb[j].n_un.n_strx) == 0)
+                return(TRUE);
+        }
+    }
+    return(FALSE);
+}
