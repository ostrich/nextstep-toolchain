 /* the pointer to the head of the fixed VM shared library segments */
 __private_extern__ struct merged_segment *fvmlib_segments = NULL;
 
+/* Reservation hints are part of a fixed-VM identity, not just its path. */
+static enum bool
+same_fvmlib_segments(struct object_file *a, struct object_file *b)
+{
+    struct object_file *objects[2];
+    struct mach_header *mh, *other;
+    struct load_command *lc, *candidate;
+    struct segment_command *left, *right;
+    unsigned long pass, i, j, matches;
+    objects[0] = a;
+    objects[1] = b;
+    for(pass = 0; pass < 2; pass++){
+        mh = (struct mach_header *)objects[pass]->obj_addr;
+        other = (struct mach_header *)objects[1-pass]->obj_addr;
+        lc = (struct load_command *)(objects[pass]->obj_addr + sizeof(*mh));
+        for(i = 0; i < mh->ncmds; i++){
+            if(lc->cmd == LC_SEGMENT &&
+               ((struct segment_command *)lc)->flags == SG_FVMLIB){
+                left = (struct segment_command *)lc;
+                candidate = (struct load_command *)(objects[1-pass]->obj_addr + sizeof(*other));
+                matches = 0;
+                for(j = 0; j < other->ncmds; j++){
+                    if(candidate->cmd == LC_SEGMENT){
+                        right = (struct segment_command *)candidate;
+                        if(right->flags == SG_FVMLIB &&
+                           left->vmaddr == right->vmaddr && left->vmsize == right->vmsize &&
+                           left->maxprot == right->maxprot && left->initprot == right->initprot &&
+                           memcmp(left->segname, right->segname, sizeof(left->segname)) == 0)
+                            matches++;
+                    }
+                    candidate = (struct load_command *)((char *)candidate + candidate->cmdsize);
+                }
+                if(matches != 1) return(FALSE);
+            }
+            lc = (struct load_command *)((char *)lc + lc->cmdsize);
+        }
+    }
+    return(TRUE);
+}
