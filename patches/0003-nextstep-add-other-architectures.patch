--- /dev/null
+++ b/gcc/config/nextstep.h
@@ -0,0 +1,71 @@
+/* Shared classic NEXTSTEP 3.3 target definitions.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#undef SIZE_TYPE
+#define SIZE_TYPE "long unsigned int"
+#undef PTRDIFF_TYPE
+#define PTRDIFF_TYPE "long int"
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "short unsigned int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 16
+
+#define ASM_DECLARE_FUNCTION_NAME(FILE, NAME, DECL) ASM_OUTPUT_LABEL (FILE, NAME)
+
+/* The generic hot/startup partitioner assumes ELF-style named sections.  */
+#undef TARGET_HAVE_NAMED_SECTIONS
+#define TARGET_HAVE_NAMED_SECTIONS false
+
+/* NeXT startup/loader owns initialization; there is no GNU __main entry.  */
+#define HAS_INIT_SECTION 1
+
+/* Debug format restoration is a separate porting stage.  */
+#define PREFERRED_DEBUGGING_TYPE NO_DEBUG
+
+#undef ASM_OUTPUT_MAX_SKIP_ALIGN
+#undef ASM_QUAD
+#undef TARGET_ASM_FILE_START_FILE_DIRECTIVE
+#define TARGET_ASM_FILE_START_FILE_DIRECTIVE false
+#undef TARGET_ASM_OUTPUT_IDENT
+#define TARGET_ASM_OUTPUT_IDENT hook_void_constcharptr
+#undef ASM_APP_ON
+#define ASM_APP_ON "#APP\n"
+#undef ASM_APP_OFF
+#define ASM_APP_OFF "#NO_APP\n"
+
+/* The NeXT lcomm alignment operand is an exponent, not bytes.  */
+#undef ASM_OUTPUT_ALIGNED_LOCAL
+#define ASM_OUTPUT_ALIGNED_LOCAL(FILE, NAME, SIZE, ALIGN)          \
+  do {                                                           \
+    fputs ("\t.lcomm ", FILE);                                    \
+    assemble_name (FILE, NAME);                                   \
+    fprintf (FILE, "," HOST_WIDE_INT_PRINT_UNSIGNED ",%u\n",       \
+             (unsigned HOST_WIDE_INT) (SIZE),                     \
+             floor_log2 ((ALIGN) / BITS_PER_UNIT));                \
+  } while (0)
+
+/* Original NEXTSTEP fixed shared-library linkage.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s"
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC ""
+#undef LIB_SPEC
+#define LIB_SPEC "-lsys_s"
+#undef LINK_SPEC
+#define LINK_SPEC ""
+
+/* Classic runtime, target sections, and NeXT header preprocessing.  */
+#define NEXT_OBJC_RUNTIME 1
+#define NEXTSTEP_CLASSIC_RUNTIME 1
+#define OBJC_DEFAULT_CONSTANT_STRING_CLASS_NAME "NXConstantString"
+#define TARGET_ASM_INIT_SECTIONS nextstep_init_sections
+#define TARGET_ASM_SELECT_SECTION nextstep_select_section
+#define TARGET_ASM_CONSTRUCTOR nextstep_asm_out_constructor
+#define TARGET_ASM_DESTRUCTOR nextstep_asm_out_destructor
+
+/* Original NeXT object format limit, in bits; independent of ABI type alignment. */
+#undef MAX_OFILE_ALIGNMENT
+#define MAX_OFILE_ALIGNMENT 0x8000
+#ifndef NEXTSTEP_OBJC_METADATA_ALIGNMENT
+#define NEXTSTEP_OBJC_METADATA_ALIGNMENT 32
+#endif
--- /dev/null
+++ b/gcc/config/m68k/nextstep.h
@@ -0,0 +1,47 @@
+/* Experimental m68k NEXTSTEP 3.3 target.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+#define NEXTSTEP_OBJC_METADATA_ALIGNMENT 16
+#include "../nextstep.h"
+
+#undef STACK_BOUNDARY
+#define STACK_BOUNDARY 32
+#undef STRUCTURE_SIZE_BOUNDARY
+#define STRUCTURE_SIZE_BOUNDARY 16
+#undef DEFAULT_PCC_STRUCT_RETURN
+#define DEFAULT_PCC_STRUCT_RETURN 0
+#undef M68K_FP_REG_NAME
+#define M68K_FP_REG_NAME REGISTER_PREFIX "a6"
+#undef LOCAL_LABEL_PREFIX
+#define LOCAL_LABEL_PREFIX ""
+#undef ASM_OUTPUT_ALIGN
+#define ASM_OUTPUT_ALIGN(FILE, LOG) \
+  do { if (LOG) fprintf (FILE, "\t.align %u\n", \
+       (in_section && (in_section->common.flags & SECTION_CODE)) \
+       ? 1U : (unsigned) (LOG)); } while (0)
+#undef ASM_OUTPUT_ALIGN_WITH_NOP
+#undef ASM_OUTPUT_SKIP
+#define ASM_OUTPUT_SKIP(FILE, SIZE) \
+  fprintf (FILE, "\t.space " HOST_WIDE_INT_PRINT_UNSIGNED "\n", \
+           (unsigned HOST_WIDE_INT) (SIZE))
+#undef SUBTARGET_OVERRIDE_OPTIONS
+#define SUBTARGET_OVERRIDE_OPTIONS \
+  do { if (flag_pic) \
+    error ("NeXT position-independent code is not implemented yet"); } while (0)
+#define DRIVER_SELF_SPECS \
+  "%{!fno-asynchronous-unwind-tables:-fno-asynchronous-unwind-tables}", \
+  "%{!fno-unwind-tables:-fno-unwind-tables}"
+#define REGISTER_TARGET_PRAGMAS() nextstep_register_cpp ()
+#define NEXTSTEP_OBJC_METHOD_STACK_OFFSET 8
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS() \
+  do { builtin_define ("NeXT"); builtin_define ("__NeXT__"); \
+    builtin_define ("__NeXT"); builtin_define_std ("unix"); \
+    builtin_define ("__MACH__"); builtin_define ("__BIG_ENDIAN__"); \
+    builtin_define_with_value ("__ARCHITECTURE__", "m68k", 1); } while (0)
+
+/* NeXT keeps switch tables outside text.  The generic m68k relative jump
+   sequence assumes an inline table immediately after the jump instruction. */
+#undef CASE_VECTOR_PC_RELATIVE
+#define CASE_VECTOR_PC_RELATIVE 0
+#undef CASE_VECTOR_MODE
+#define CASE_VECTOR_MODE SImode
