+/* DWARF output names include the Mach-O segment and section attributes.
+   Do not pass ELF named-section syntax to the historical assembler. */
+void
+nextstep_asm_named_section (const char *name, unsigned int flags,
+                           tree decl ATTRIBUTE_UNUSED)
+{
+  if (!(flags & SECTION_DEBUG) || strncmp (name, "__DWARF,", 8))
+    {
+      error ("unsupported NEXTSTEP named section %qs", name);
+      return;
+    }
+  fprintf (asm_out_file, "\t.section %s\n", name);
+  if (!(flags & SECTION_DECLARED))
+    {
+      const char *start = name + 8;
+      const char *end = strchr (start, ',');
+      gcc_assert (end);
+      fprintf (asm_out_file, "Lns33section%.*s:\n", (int) (end - start), start);
+    }
+}
+
+/* Assignment forces an assembly-time constant even when a local label is
+   exactly at a section boundary.  Plain subtraction can instead acquire an
+   incorrect section-difference relocation in the Mach-O assembler. */
+void
+nextstep_asm_output_dwarf_delta (FILE *file, int size, const char *first,
+                                const char *second, HOST_WIDE_INT offset)
+{
+  static unsigned int serial;
+  const char *directive = size == 1 ? ".byte" : size == 2 ? ".short"
+                          : size == 4 ? ".long" : ".quad";
+  fprintf (file, "\t.set Lns33delta%u,", serial);
+  assemble_name_raw (file, first);
+  fputc ('-', file);
+  assemble_name_raw (file, second);
+  if (offset)
+    fprintf (file, "+" HOST_WIDE_INT_PRINT_DEC, offset);
+  fprintf (file, "\n\t%s Lns33delta%u", directive, serial++);
+}
+
+void
+nextstep_asm_output_dwarf_offset (FILE *file, int size, const char *label,
+                                 HOST_WIDE_INT offset, section *base)
+{
+  gcc_assert (base->common.flags & SECTION_NAMED);
+  const char *start = base->named.name + 8;
+  const char *end = strchr (start, ',');
+  gcc_assert (end && !strncmp (base->named.name, "__DWARF,", 8));
+  char section_label[64];
+  snprintf (section_label, sizeof section_label, "*Lns33section%.*s",
+            (int) (end - start), start);
+  nextstep_asm_output_dwarf_delta (file, size, label, section_label, offset);
+}
