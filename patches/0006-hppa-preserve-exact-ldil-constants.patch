--- a/gcc/config/pa/pa.cc
+++ b/gcc/config/pa/pa.cc
@@ -2742,7 +2742,7 @@
       if (VAL_14_BITS_P (intval))
 	return "ldi %1,%0";
       else if ((intval & 0x7ff) == 0)
-	return "ldil L%'%1,%0";
+	return "ldil %u1,%0";
       else if (pa_zdepi_cint_p (intval))
 	return "{zdepi %Z1,%0|depwi,z %Z1,%0}";
       else
@@ -5483,6 +5483,15 @@
 {
   switch (code)
     {
+    case 'u':
+      /* NeXT's L` selector uses the rounded LR/RR convention.  Applying it
+         to an exact ldil integer (whose low 11 bits are zero) can discard
+         bits 11 and 12.  A selector-free immediate loads the exact high
+         21 bits.  Symbolic HIGH/LO_SUM pairs retain their native selectors. */
+      if (!TARGET_NEXTSTEP)
+        fputs ("L'", file);
+      pa_print_operand (file, x, 0);
+      return;
     case '!':
       fputs (TARGET_NEXTSTEP ? "%r30" : "%sp", file);
       return;
