--- /dev/null
+++ b/gcc/config/i386/nextstep.h
@@ -0,0 +1,97 @@
+/* Experimental Intel NEXTSTEP 3.3 target for GCC.
+   SPDX-License-Identifier: GPL-3.0-or-later
+   This initial target supports non-PIC C code generation only.  */
+
+#undef TARGET_SUBTARGET_DEFAULT
+#define TARGET_SUBTARGET_DEFAULT (MASK_80387 | MASK_IEEE_FP | MASK_FLOAT_RETURNS)
+
+#define NEXTSTEP_STRUCT_VALUE_REGNUM BX_REG
+#define TARGET_STRUCT_VALUE_RTX ix86_nextstep_struct_value_rtx
+#undef KEEP_AGGREGATE_RETURN_POINTER
+#define KEEP_AGGREGATE_RETURN_POINTER 1
+
+#undef DEFAULT_PCC_STRUCT_RETURN
+#define DEFAULT_PCC_STRUCT_RETURN 0
+#undef PREFERRED_STACK_BOUNDARY_DEFAULT
+#define PREFERRED_STACK_BOUNDARY_DEFAULT 32
+
+#undef SIZE_TYPE
+#define SIZE_TYPE "long unsigned int"
+#undef PTRDIFF_TYPE
+#define PTRDIFF_TYPE "long int"
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "short unsigned int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 16
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()                         \
+  do {                                                  \
+    builtin_define ("NeXT");                             \
+    builtin_define_std ("unix");                         \
+    builtin_define ("__MACH__");                         \
+    builtin_define ("__LITTLE_ENDIAN__");                \
+    builtin_define_with_value ("__ARCHITECTURE__", "i386", 1); \
+  } while (0)
+
+#define ASM_DECLARE_FUNCTION_NAME(FILE, NAME, DECL) ASM_OUTPUT_LABEL (FILE, NAME)
+
+/* The generic hot/startup partitioner assumes ELF-style named sections.  */
+#undef TARGET_HAVE_NAMED_SECTIONS
+#define TARGET_HAVE_NAMED_SECTIONS false
+
+/* NeXT startup/loader owns initialization; there is no GNU __main entry.  */
+#define HAS_INIT_SECTION 1
+
+/* Debug format restoration is a separate porting stage.  */
+#define PREFERRED_DEBUGGING_TYPE NO_DEBUG
+
+/* Feature detection must not select directives supported only by host gas.  */
+#undef ASM_OUTPUT_ALIGN
+#define ASM_OUTPUT_ALIGN(FILE, LOG) \
+  do { if (LOG) fprintf (FILE, "\t.align %d%s\n", (LOG), \
+       (in_section && (in_section->common.flags & SECTION_CODE)) \
+       ? ",0x90" : ""); } while (0)
+#undef ASM_OUTPUT_MAX_SKIP_ALIGN
+#undef ASM_QUAD
+#undef TARGET_ASM_FILE_START_FILE_DIRECTIVE
+#define TARGET_ASM_FILE_START_FILE_DIRECTIVE false
+#undef TARGET_ASM_OUTPUT_IDENT
+#define TARGET_ASM_OUTPUT_IDENT hook_void_constcharptr
+#undef ASM_APP_ON
+#define ASM_APP_ON "#APP\n"
+#undef ASM_APP_OFF
+#define ASM_APP_OFF "#NO_APP\n"
+
+/* The NeXT lcomm alignment operand is an exponent, not bytes.  */
+#undef ASM_OUTPUT_ALIGNED_LOCAL
+#define ASM_OUTPUT_ALIGNED_LOCAL(FILE, NAME, SIZE, ALIGN)          \
+  do {                                                           \
+    fputs ("\t.lcomm ", FILE);                                    \
+    assemble_name (FILE, NAME);                                   \
+    fprintf (FILE, "," HOST_WIDE_INT_PRINT_UNSIGNED ",%u\n",       \
+             (unsigned HOST_WIDE_INT) (SIZE),                     \
+             floor_log2 ((ALIGN) / BITS_PER_UNIT));                \
+  } while (0)
+
+/* Do not silently emit ELF PIC relocations for a Mach-O target.  */
+#define SUBTARGET_OVERRIDE_OPTIONS                               \
+  do {                                                           \
+    if (flag_pic)                                                \
+      error ("NeXT position-independent code is not implemented yet"); \
+  } while (0)
+
+#undef SUBTARGET_DRIVER_SELF_SPECS
+#define SUBTARGET_DRIVER_SELF_SPECS \
+  "%{!fno-asynchronous-unwind-tables:-fno-asynchronous-unwind-tables}", \
+  "%{!fno-unwind-tables:-fno-unwind-tables}"
+
+/* Original NEXTSTEP fixed shared-library linkage.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s"
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC ""
+#undef LIB_SPEC
+#define LIB_SPEC "-lsys_s"
+#undef LINK_SPEC
+#define LINK_SPEC ""
--- a/gcc/config/i386/i386.cc
+++ b/gcc/config/i386/i386.cc
@@ -29112,6 +29112,15 @@
 #undef TARGET_SHRINK_WRAP_SET_HANDLED_COMPONENTS
 #define TARGET_SHRINK_WRAP_SET_HANDLED_COMPONENTS ix86_set_handled_components
 
+#ifdef NEXTSTEP_STRUCT_VALUE_REGNUM
+/* Original NeXT ABI: the hidden aggregate return address is passed in EBX.  */
+static rtx
+ix86_nextstep_struct_value_rtx (tree, int)
+{
+  return gen_rtx_REG (Pmode, NEXTSTEP_STRUCT_VALUE_REGNUM);
+}
+#endif
+
 struct gcc_target targetm = TARGET_INITIALIZER;
 
 #include "gt-i386.h"
