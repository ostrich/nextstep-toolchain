+/* 68881 and ColdFire floating registers hold numeric values, not the
+   unconverted memory bit patterns.  In particular, a saved XF value cannot
+   be used as the low SF word of a caller-save slot.  */
+static bool
+m68k_can_change_mode_class (machine_mode from, machine_mode to,
+                            reg_class_t rclass)
+{
+  return (from == to || !TARGET_HARD_FLOAT
+          || !reg_classes_intersect_p (FP_REGS, rclass));
+}
