+/* Classic NeXT section placement for GCC.
+   SPDX-License-Identifier: GPL-3.0-or-later
+   Directive ordering follows the original NeXT target.  Metadata tags follow
+   GCC's modern traditional NeXT runtime and Darwin section selection.  */
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "backend.h"
+#include "target.h"
+#include "rtl.h"
+#include "tree.h"
+#include "stringpool.h"
+#include "attribs.h"
+#include "output.h"
+#include "diagnostic-core.h"
+
+struct nextstep_metadata_section
+{
+  const char *tag;
+  const char *directive;
+  section *sect;
+};
+
+/* Unnamed sections are rooted by varasm's unnamed_sections list.  */
+static nextstep_metadata_section metadata[] = {
+  {"V1_CLAS", ".objc_class", NULL},
+  {"V1_META", ".objc_meta_class", NULL},
+  {"V1_CACM", ".objc_cat_cls_meth", NULL},
+  {"V1_CAIM", ".objc_cat_inst_meth", NULL},
+  {"V1_CLCM", ".objc_cls_meth", NULL},
+  {"V1_CLIM", ".objc_inst_meth", NULL},
+  {"V1_SRFS", ".objc_message_refs", NULL},
+  {"V1_SYMT", ".objc_symbols", NULL},
+  {"V1_CATG", ".objc_category", NULL},
+  {"V1_PROT", ".objc_protocol", NULL},
+  {"V1_CLCV", ".objc_class_vars", NULL},
+  {"V1_CLIV", ".objc_instance_vars", NULL},
+  {"V1_MODU", ".objc_module_info", NULL},
+  {"V1_CSTR", ".objc_string_object", NULL},
+  {"V1_CLSN", ".objc_class_names", NULL},
+  {"V1_METN", ".objc_meth_var_names", NULL},
+  {"V1_METT", ".objc_meth_var_types", NULL},
+  {"V1_CLRF", ".objc_cls_refs", NULL}
+};
+static section *constructors, *destructors;
+
+static void
+nextstep_objc_section (const char *directive)
+{
+  static bool initialized;
+  if (!initialized)
+    {
+      initialized = true;
+      /* NeXT as expects the classic section ordering before population.  */
+      for (unsigned i = 0; i < ARRAY_SIZE (metadata); ++i)
+        switch_to_section (metadata[i].sect);
+    }
+  output_section_asm_op (directive);
+}
+
+void
+nextstep_init_sections (void)
+{
+  readonly_data_section = get_unnamed_section (0, output_section_asm_op, ".const");
+  constructors = get_unnamed_section (SECTION_WRITE, output_section_asm_op,
+                                     ".constructor");
+  destructors = get_unnamed_section (SECTION_WRITE, output_section_asm_op,
+                                    ".destructor");
+  for (unsigned i = 0; i < ARRAY_SIZE (metadata); ++i)
+    metadata[i].sect = get_unnamed_section (SECTION_WRITE,
+                                          nextstep_objc_section,
+                                          metadata[i].directive);
+}
+
+section *
+nextstep_select_section (tree decl, int reloc, unsigned HOST_WIDE_INT align)
+{
+  if (DECL_P (decl))
+    {
+      tree attr = lookup_attribute ("OBJC1META", DECL_ATTRIBUTES (decl));
+      if (attr && TREE_VALUE (attr)
+          && TREE_CODE (TREE_VALUE (attr)) == IDENTIFIER_NODE)
+        {
+          const char *tag = IDENTIFIER_POINTER (TREE_VALUE (attr));
+          for (unsigned i = 0; i < ARRAY_SIZE (metadata); ++i)
+            if (!strcmp (tag, metadata[i].tag))
+              return metadata[i].sect;
+          /* Protocol lists are referenced indirectly, as on Darwin ABI 0.  */
+          if (!strcmp (tag, "V1_PCLM") || !strcmp (tag, "V1_CLPR")
+              || !strcmp (tag, "V1_PRFS"))
+            return metadata[2].sect;
+          if (!strcmp (tag, "V1_PNSM"))
+            return metadata[3].sect;
+          /* Image info and otherwise-unrecognized metadata remain writable. */
+          return data_section;
+        }
+    }
+  /* Constant-string CONST_DECLs reach varasm as constructor values, so their
+     declaration metadata is no longer available here.  */
+  if (TREE_CODE (decl) == CONSTRUCTOR && TREE_TYPE (decl)
+      && TREE_CODE (TREE_TYPE (decl)) == RECORD_TYPE
+      && TYPE_NAME (TREE_TYPE (decl)))
+    {
+      tree name = TYPE_NAME (TREE_TYPE (decl));
+      if (TREE_CODE (name) == TYPE_DECL)
+        name = DECL_NAME (name);
+      if (name && TREE_CODE (name) == IDENTIFIER_NODE
+          && !strcmp (IDENTIFIER_POINTER (name), "__builtin_ObjCString"))
+        return metadata[13].sect;
+    }
+  return default_select_section (decl, reloc, align);
+}
+
+void
+nextstep_asm_out_constructor (rtx symbol, int priority)
+{
+  if (priority != DEFAULT_INIT_PRIORITY)
+    sorry ("constructor priorities are not supported on classic NeXT");
+  switch_to_section (constructors);
+  assemble_align (POINTER_SIZE);
+  assemble_integer (symbol, POINTER_SIZE / BITS_PER_UNIT, POINTER_SIZE, 1);
+  fputs (".reference .constructors_used\n", asm_out_file);
+}
+
+void
+nextstep_asm_out_destructor (rtx symbol, int priority)
+{
+  if (priority != DEFAULT_INIT_PRIORITY)
+    sorry ("destructor priorities are not supported on classic NeXT");
+  switch_to_section (destructors);
+  assemble_align (POINTER_SIZE);
+  assemble_integer (symbol, POINTER_SIZE / BITS_PER_UNIT, POINTER_SIZE, 1);
+  fputs (".reference .destructors_used\n", asm_out_file);
+}
