+/* C-family support for classic NeXT targets.
+   SPDX-License-Identifier: GPL-3.0-or-later
+   Class archive references follow GCC's Darwin C-family implementation.  */
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "target.h"
+#include "tree.h"
+#include "c-family/c-common.h"
+#include "c-family/c-target.h"
+#include "c-family/c-target-def.h"
+#include "cgraph.h"
+#include "c-family/c-pragma.h"
+
+void
+nextstep_register_cpp (void)
+{
+  cpp_get_options (parse_in)->nextstep_include_concat = 1;
+  /* Match the original compiler's default SDK namespace in GNU modes.
+     Command-line -D/-U options are processed after target registration.  */
+  if (!flag_iso)
+    cpp_define (parse_in, "_NEXT_SOURCE");
+  /* SDK protocol declarations are selected by this compatibility feature.  */
+  cpp_define (parse_in, "NX_COMPILER_RELEASE_3_0=300");
+}
+
+static void
+nextstep_class_reference (const char *name)
+{
+  char *text = concat (".reference\t", name, NULL);
+  symtab->finalize_toplevel_asm (build_string (strlen (text), text));
+  free (text);
+}
+
+static void
+nextstep_class_definition (const char *name)
+{
+  const char *symbol = targetm.strip_name_encoding (name);
+  char *text = concat (".globl\t", symbol, "\n", symbol, " = 0", NULL);
+  symtab->finalize_toplevel_asm (build_string (strlen (text), text));
+  free (text);
+}
+
+#undef TARGET_OBJC_DECLARE_UNRESOLVED_CLASS_REFERENCE
+#define TARGET_OBJC_DECLARE_UNRESOLVED_CLASS_REFERENCE nextstep_class_reference
+#undef TARGET_OBJC_DECLARE_CLASS_DEFINITION
+#define TARGET_OBJC_DECLARE_CLASS_DEFINITION nextstep_class_definition
+
+#undef TARGET_CXX_SYSTEM_HEADERS_IMPLICIT_EXTERN_C
+#define TARGET_CXX_SYSTEM_HEADERS_IMPLICIT_EXTERN_C true
+
+struct gcc_targetcm targetcm = TARGETCM_INITIALIZER;
