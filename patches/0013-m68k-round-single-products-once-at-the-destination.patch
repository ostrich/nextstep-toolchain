--- a/gcc/config/m68k/m68k.cc
+++ b/gcc/config/m68k/m68k.cc
@@ -7338,3 +7338,19 @@
     }
   emit_move_insn (operands[0], result);
 }
+
+/* A float product has at most 48 significant bits, exactly representable in
+   extended precision.  FSGLMUL's 24-bit significand with extended exponent
+   range can double-round subnormal results.  Perform the range conversion
+   exactly once through an SF memory destination, also on 68881 machines. */
+void
+m68k_expand_single_multiply (rtx *operands)
+{
+  rtx left = force_reg (XFmode, convert_to_mode (XFmode, operands[1], 0));
+  rtx right = force_reg (XFmode, convert_to_mode (XFmode, operands[2], 0));
+  rtx product = gen_reg_rtx (XFmode);
+  rtx rounded = assign_stack_temp (SFmode, GET_MODE_SIZE (SFmode));
+  emit_insn (gen_mulxf3_68881 (product, left, right));
+  convert_move (rounded, product, 0);
+  emit_move_insn (operands[0], rounded);
+}
