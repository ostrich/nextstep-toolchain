+/* Native NEXTSTEP locks for the upstream atomic fallback algorithms.
+   SPDX-License-Identifier: GPL-3.0-or-later WITH GCC-exception-3.1 */
+#include "libatomic_i.h"
+
+/* These original cthreads primitives need no cthread_init and cannot recurse
+   into libatomic.  In particular, do not use the modern gthread bridge here:
+   that bridge itself needs atomics to initialize its native thread state. */
+extern void spin_lock (int *);
+extern void spin_unlock (int *);
+static int fallback_lock;
+
+/* One lock provides a common order across both the sized and generic paths,
+   including ranges which overlap a lock granule or page boundary.  This
+   conservative fallback also avoids virtual-alias hashing assumptions. */
+void libat_lock_1 (void *ptr UNUSED) { spin_lock (&fallback_lock); }
+void libat_unlock_1 (void *ptr UNUSED) { spin_unlock (&fallback_lock); }
+void libat_lock_n (void *ptr UNUSED, size_t n UNUSED)
+{ spin_lock (&fallback_lock); }
+void libat_unlock_n (void *ptr UNUSED, size_t n UNUSED)
+{ spin_unlock (&fallback_lock); }
