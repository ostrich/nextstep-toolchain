+
+static long double parse_string(const char *s, char **end, int precision)
+{
+  struct parse_stream stream = { (const unsigned char *)s, (const unsigned char *)s, 0 };
+  long double value = parse_float(&stream, precision, 1);
+  if (precision == 0) {
+    volatile float rounded = value;
+    if ((value != 0 && rounded == 0) ||
+        (__builtin_isfinite(value) && !__builtin_isfinite(rounded)) ||
+        (rounded != 0 && __builtin_fabsl(rounded) < FLT_MIN)) errno = ERANGE;
+  } else if (precision == 1) {
+    volatile double rounded = value;
+    if ((value != 0 && rounded == 0) ||
+        (__builtin_isfinite(value) && !__builtin_isfinite(rounded)) ||
+        (rounded != 0 && __builtin_fabsl(rounded) < DBL_MIN)) errno = ERANGE;
+  }
+  if (end) *end = (char *)(stream.failed ? (const unsigned char *)s : stream.cursor);
+  return value;
+}
+float strtof(const char *s, char **end) { return parse_string(s, end, 0); }
+double strtod(const char *s, char **end) { return parse_string(s, end, 1); }
+long double strtold(const char *s, char **end) { return parse_string(s, end, 2); }
