+/* The single-byte C locale has one collating element per byte, and each
+   equivalence class contains that byte alone. Multicharacter locale elements
+   are deliberately rejected rather than interpreted as ordinary letters. */
+static reg_errcode_t parse_bracket_character(const char *s, wchar_t *wc,
+                                            int *len, int *equivalence)
+{
+	*equivalence = 0;
+	if (*s == '[' && (s[1] == '.' || s[1] == '=')) {
+		if (!s[2] || s[3] != s[1] || s[4] != ']')
+			return REG_ECOLLATE;
+		*wc = (unsigned char)s[2];
+		*len = 5;
+		*equivalence = s[1] == '=';
+		return REG_OK;
+	}
+	*len = mbtowc(wc, s, -1);
+	return *len > 0 ? REG_OK : (*s ? REG_BADPAT : REG_EBRACK);
+}
