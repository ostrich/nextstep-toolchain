+/* Bounded output only. Native FILE internals and libc locks are not used. */
+struct format_stream {
+  char *cursor;
+  size_t available;
+  int error;
+};
+#define NL_ARGMAX 9
+
+static size_t format_strnlen(const char *text, size_t limit)
+{
+  size_t length = 0;
+  while (length != limit && text[length]) ++length;
+  return length;
+}
+
+/* Scaling by powers of two is exact, including subnormal inputs. Avoid
+   narrowing extended precision through the original double-only libc. */
+static long double format_frexpl(long double value, int *exponent)
+{
+  int shift = 0;
+  int negative = signbit(value);
+  if (!value || !isfinite(value)) { *exponent = 0; return value; }
+  if (negative) value = -value;
+  while (value >= 0x1p32L) { value *= 0x1p-32L; shift += 32; }
+  while (value < 0x1p-32L) { value *= 0x1p32L; shift -= 32; }
+  while (value >= 1.0L) { value *= 0.5L; ++shift; }
+  while (value < 0.5L) { value *= 2.0L; --shift; }
+  *exponent = shift;
+  return negative ? -value : value;
+}
 
