+int vsnprintf(char *restrict buffer, size_t size, const char *restrict format,
+              va_list arguments)
+{
+  va_list copy;
+  int types[NL_ARGMAX + 1] = {0};
+  union arg values[NL_ARGMAX + 1];
+  struct format_stream stream = {buffer, size ? size - 1 : 0, 0};
+  int result;
+  va_copy(copy, arguments);
+  result = printf_core(0, format, &copy, values, types);
+  if (result >= 0)
+    result = printf_core(&stream, format, &copy, values, types);
+  if (size) *stream.cursor = 0;
+  va_end(copy);
+  return result;
+}
+
+int snprintf(char *restrict buffer, size_t size, const char *restrict format, ...)
+{
+  int result;
+  va_list arguments;
+  va_start(arguments, format);
+  result = vsnprintf(buffer, size, format, arguments);
+  va_end(arguments);
+  return result;
+}
