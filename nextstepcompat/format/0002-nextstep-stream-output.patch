+
+/* Public stream interfaces retain the native FILE ABI and buffering. */
+int ns33_vfprintf(FILE *file, const char *format, va_list arguments)
+{
+  va_list copy;
+  int types[NL_ARGMAX + 1] = {0};
+  union arg values[NL_ARGMAX + 1];
+  struct format_stream stream = {0, 0, 0, file};
+  int result;
+  va_copy(copy, arguments);
+  result = printf_core(0, format, &copy, values, types);
+  if (result >= 0) result = printf_core(&stream, format, &copy, values, types);
+  va_end(copy);
+  return stream.error ? -1 : result;
+}
+int ns33_fprintf(FILE *file, const char *format, ...)
+{
+  va_list args;
+  int result;
+  va_start(args, format);
+  result = ns33_vfprintf(file, format, args);
+  va_end(args);
+  return result;
+}
+int ns33_vprintf(const char *format, va_list args)
+{
+  return ns33_vfprintf(stdout, format, args);
+}
+int ns33_printf(const char *format, ...)
+{
+  va_list args;
+  int result;
+  va_start(args, format);
+  result = ns33_vfprintf(stdout, format, args);
+  va_end(args);
+  return result;
+}
